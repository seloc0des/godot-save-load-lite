; Demo / dev project for Save / Load — Lite.

config_version=5

[application]

config/name="Save / Load — Lite — Demo"
config/description="Free single-slot JSON save/load for Godot 4.3+."
config/features=PackedStringArray("4.3", "GL Compatibility")
run/main_scene="res://demo/save_demo.tscn"

[autoload]

SaveLite="*res://addons/save_load_lite/save_lite.gd"

[display]

window/size/viewport_width=900
window/size/viewport_height=520

[editor_plugins]

enabled=PackedStringArray("res://addons/save_load_lite/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
